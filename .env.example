# Copy to .env and fill in. Never commit .env, never put a real value here.

# --- Runtime ------------------------------------------------------------
ENV=development

# --- ialab-logging ------------------------------------------------------
# IALAB_PROJECT must match project.name in monitoring/config/<slug>.yaml.
IALAB_PROJECT=YOUR_PROJECT
LOG_FILE=app.log
LOG_NAMESPACE=app
# LOG_LEVEL=DEBUG
# LOG_DIR=logs

# --- ialab-platform MCP server ------------------------------------------
# Service token of dashboard-api. Read from the environment by .mcp.json,
# never written into a versioned file.
IALAB_SERVICE_TOKEN=YOUR_SERVICE_TOKEN

# --- Application --------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DB

# --- Upmeet -------------------------------------------------------------
UPMEET_API_KEY=YOUR_UPMEET_API_KEY
# UPMEET_BASE_URL=https://api.upmeet.ai
# UPMEET_TIMEOUT_SECONDS=30
# UPMEET_MAX_RETRIES=3
